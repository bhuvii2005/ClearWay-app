# ClearWay settings. Copy this file to .env and replace every placeholder:
#   cp .env.example .env
# .env is git-ignored and Docker-ignored. Never commit it or paste real values into this file.

# --- Database (Docker creates it with these values the first time it starts) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=cleanroute_db
POSTGRES_PORT=5435

# --- API connection to the database (use the same user and password as above) ---
# When the API runs in Docker, docker-compose.yml points it at the database container itself.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/cleanroute_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_db_password

# --- TomTom routing (free key: https://developer.tomtom.com > Dashboard > Keys) ---
TOMTOM_API_KEY=change_me_tomtom_key

# --- ClearWay Coach (AI), free tiers only. Optional: without a key the Coach answers 503 and
#     everything else works. Never commit real keys.
# Gemini: Coach chat (default) and knowledge-base embeddings, one key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=change_me_gemini_key
# GEMINI_CHAT_MODEL=gemini-3.5-flash   # default. gemini-3.8-flash is listed for free keys too, but hung (no reply) in testing
# Optional: Groq as the chat provider instead (free key: https://console.groq.com/keys)
# GROQ_API_KEY=change_me_groq_key
# CLEARWAY_AI_CHAT_PROVIDER=groq
# Coach speed: reasoning effort per call (blank = model default) and the total time for one message
# CLEARWAY_AI_REASONING_EFFORT=low
# CLEARWAY_AI_COACH_TOTAL_TIMEOUT=45s
# Daily caps the app keeps below the free quota (requests and tokens; reset at midnight Pacific)
# CLEARWAY_AI_DAILY_REQUESTS=200
# CLEARWAY_AI_DAILY_TOKENS=300000
# Embeddings have their own Gemini quota: daily request cap, and the per-minute pace for ingestion
# CLEARWAY_AI_EMBED_DAILY_REQUESTS=500
# CLEARWAY_AI_EMBED_RPM=30
# Knowledge base: load kb/*.md into the database on start-up (skips files that haven't changed)
# CLEARWAY_AI_KB_INGEST_ON_STARTUP=true
# CLEARWAY_AI_KB_SIMILARITY_THRESHOLD=0.6
# Live checks (./gradlew evalTest): provider, their own small budget, and spacing for the RPM limit
# CLEARWAY_EVAL_PROVIDER=gemini
# CLEARWAY_EVAL_MAX_REQUESTS=20
# CLEARWAY_EVAL_MAX_TOKENS=20000
# CLEARWAY_EVAL_RPM=5

# --- Login tokens: a long random value, at least 32 characters ---
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# --- Web app: the address the browser uses to reach the API ---
VITE_API_URL=http://localhost:8090

# --- Optional host ports for docker compose ---
# API_PORT=8090
# WEB_PORT=4173
