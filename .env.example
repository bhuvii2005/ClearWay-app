# ClearWay settings. Copy this file to .env and replace every placeholder:
#   cp .env.example .env
# .env is git-ignored and Docker-ignored. Never commit it or paste real values into this file.

# --- Database (Docker creates it with these values the first time it starts) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=cleanroute_db
POSTGRES_PORT=5435

# --- API connection to the database (use the same user and password as above) ---
# When the API runs in Docker, docker-compose.yml points it at the database container itself.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5435/cleanroute_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change_me_db_password

# --- TomTom routing (free key: https://developer.tomtom.com > Dashboard > Keys) ---
TOMTOM_API_KEY=change_me_tomtom_key

# --- Login tokens: a long random value, at least 32 characters ---
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRATION_MS=86400000

# --- Web app: the address the browser uses to reach the API ---
VITE_API_URL=http://localhost:8090

# --- Optional host ports for docker compose ---
# API_PORT=8090
# WEB_PORT=4173
